# Copy to .env (never commit .env) and fill in real values, then export them
# before running the app, e.g.:  set -a; source .env; set +a; python app.py

# Long random string used to sign session cookies:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# https://newsapi.org
NEWS_API_KEY=

# RapidAPI key with access to TrueWay Directions and TrueWay Places
RAPIDAPI_KEY=

# Gmail account + app password used to send SOS emails
MAIL_SENDER=
MAIL_PASSWORD=

# Optional
FLASK_DEBUG=0               # set to 1 only on your own machine
SESSION_COOKIE_SECURE=0     # set to 1 when served over HTTPS
NGROK_TOKEN=                # only for Module3.ipynb on Colab
